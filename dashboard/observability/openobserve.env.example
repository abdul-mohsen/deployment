# Copy to openobserve.env, replace the credentials, and protect the file
# (chmod 600). This file is ignored by git and is used by the native
# OpenObserve root-user configuration.
ZO_ROOT_USER_EMAIL=operator@example.invalid
ZO_ROOT_USER_PASSWORD=replace-with-a-long-random-password

# Host publication is loopback-only by default. Do not change the bind address
# without an approved operator access path and firewall rule.
OBS_OPENOBSERVE_BIND=127.0.0.1
OBS_OPENOBSERVE_PORT=5080

# The deployment-only pilot retains telemetry for 14 days by default.
OBS_OPENOBSERVE_RETENTION_DAYS=14
OBS_OPENOBSERVE_IGNORE_STREAM_RETENTION=false
OBS_OPENOBSERVE_DELETE_DELAY_HOURS=2

# Starting resource budget for a small operator pilot.
OBS_OPENOBSERVE_MEMORY_LIMIT=1g
OBS_OPENOBSERVE_CPUS=1.00
OBS_OPENOBSERVE_PIDS_LIMIT=256

# The collector is fail-open: Alloy keeps only bounded in-memory batches and
# the gateway keeps a separate durable queue capped per signal.
OBS_OPENOBSERVE_QUEUE_MAX_BYTES=67108864
OBS_OPENOBSERVE_MAX_BODY_BYTES=4194304
OBS_OPENOBSERVE_GATEWAY_MEMORY_LIMIT=256m
OBS_OPENOBSERVE_GATEWAY_CPUS=0.50
OBS_OPENOBSERVE_GATEWAY_PIDS_LIMIT=128
OBS_OPENOBSERVE_ALLOY_MEMORY_LIMIT=384m
OBS_OPENOBSERVE_ALLOY_CPUS=0.75
OBS_OPENOBSERVE_ALLOY_PIDS_LIMIT=256

# Resource collection uses the filtered Docker API and approved role
# aggregates only; it does not expose container IDs or tenant IDs as labels.
OBS_OPENOBSERVE_RESOURCE_POLL_INTERVAL=15s
OBS_OPENOBSERVE_RESOURCE_EXPORTER_MEMORY_LIMIT=128m
OBS_OPENOBSERVE_RESOURCE_EXPORTER_CPUS=0.25
OBS_OPENOBSERVE_DOCKER_PROXY_MEMORY_LIMIT=128m
OBS_OPENOBSERVE_DOCKER_PROXY_CPUS=0.25
OBS_OPENOBSERVE_DOCKER_PROXY_PIDS_LIMIT=64
OBS_OPENOBSERVE_DOCKER_FILTER_MEMORY_LIMIT=128m
OBS_OPENOBSERVE_DOCKER_FILTER_CPUS=0.25
OBS_OPENOBSERVE_DOCKER_FILTER_PIDS_LIMIT=64
OBS_OPENOBSERVE_NODE_EXPORTER_MEMORY_LIMIT=128m
OBS_OPENOBSERVE_NODE_EXPORTER_CPUS=0.25

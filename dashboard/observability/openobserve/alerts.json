{
  "schema_version": 1,
  "destination_placeholder": "${OPENOBSERVE_ALERT_DESTINATION_NAME}",
  "alerts": [
    {
      "name": "Ifritah - Elevated 5xx responses",
      "stream_type": "logs",
      "stream_name": "ifritah_logs_v1",
      "description": "Notify when five or more 5xx request completions occur in ten minutes.",
      "query_condition": {
        "type": "sql",
        "sql": "SELECT COUNT(*) AS alert_count FROM \"ifritah_logs_v1\" WHERE _timestamp >= now() - INTERVAL '10 minutes' AND event_type = 'http.request.completed' AND status_class = '5xx'"
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 5,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Panic or exception recovered",
      "stream_type": "logs",
      "stream_name": "ifritah_logs_v1",
      "description": "Notify when a recovered panic or bounded exception event is emitted.",
      "query_condition": {
        "type": "sql",
        "sql": "SELECT COUNT(*) AS alert_count FROM \"ifritah_logs_v1\" WHERE _timestamp >= now() - INTERVAL '10 minutes' AND (event_type = 'http.panic_recovered' OR panic_type IS NOT NULL OR exception_type IS NOT NULL)"
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 1,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Authentication rejection burst",
      "stream_type": "logs",
      "stream_name": "ifritah_logs_v1",
      "description": "Notify when rejected auth decisions exceed the pilot threshold.",
      "query_condition": {
        "type": "sql",
        "sql": "SELECT COUNT(*) AS alert_count FROM \"ifritah_logs_v1\" WHERE _timestamp >= now() - INTERVAL '10 minutes' AND event_type = 'auth.decision' AND outcome = 'rejected'"
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 10,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Migration or deployment failure",
      "stream_type": "logs",
      "stream_name": "ifritah_logs_v1",
      "description": "Notify on a failed deployment operation, including migration stage failures.",
      "query_condition": {
        "type": "sql",
        "sql": "SELECT COUNT(*) AS alert_count FROM \"ifritah_logs_v1\" WHERE _timestamp >= now() - INTERVAL '10 minutes' AND event_type = 'deployment.operation' AND outcome = 'failure' AND deployment_stage IN ('migration', 'backup', 'image_swap', 'verify', 'rollback')"
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 1,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Request latency budget",
      "stream_type": "logs",
      "stream_name": "ifritah_logs_v1",
      "description": "Notify when the average request duration exceeds the pilot budget.",
      "query_condition": {
        "type": "sql",
        "sql": "SELECT AVG(duration_ms) AS alert_value FROM \"ifritah_logs_v1\" WHERE _timestamp >= now() - INTERVAL '10 minutes' AND event_type = 'http.request.completed'"
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 1000,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Collector drops or lag",
      "stream_type": "logs",
      "stream_name": "ifritah_telemetry_health_v1",
      "description": "Notify when collector drops, queue pressure, parse failures, or lag are observed.",
      "query_condition": {
        "type": "sql",
        "sql": "SELECT COUNT(*) AS alert_count FROM \"ifritah_telemetry_health_v1\" WHERE _timestamp >= now() - INTERVAL '10 minutes' AND (dropped_records > 0 OR parse_failures > 0 OR lag_ms > 60000 OR queue_depth > 1000)"
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 1,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - OpenObserve health degraded",
      "stream_type": "logs",
      "stream_name": "ifritah_telemetry_health_v1",
      "description": "Notify when collector or OpenObserve health is degraded or failing.",
      "query_condition": {
        "type": "sql",
        "sql": "SELECT COUNT(*) AS alert_count FROM \"ifritah_telemetry_health_v1\" WHERE _timestamp >= now() - INTERVAL '10 minutes' AND (component IN ('collector', 'openobserve') OR service_name = 'openobserve') AND outcome IN ('degraded', 'failure', 'dropped')"
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 1,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Resource pressure",
      "stream_type": "metrics",
      "stream_name": "ifritah_container_cpu_usage_ratio",
      "description": "Notify when approved container-role CPU exceeds 90 percent.",
      "query_condition": {
        "type": "promql",
        "promql": "100 * max by (container_role) (ifritah_container_cpu_usage_ratio)",
        "promql_condition": {
          "column": "value",
          "operator": ">=",
          "value": 90
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 90,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Container memory pressure",
      "stream_type": "metrics",
      "stream_name": "ifritah_container_memory_working_set_bytes",
      "description": "Notify when an approved container role's aggregate working set exceeds the 1 GiB pilot threshold.",
      "query_condition": {
        "type": "promql",
        "promql": "max by (container_role) (ifritah_container_memory_working_set_bytes)",
        "promql_condition": {
          "column": "value",
          "operator": ">=",
          "value": 1073741824
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 1073741824,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Filesystem or disk pressure",
      "stream_type": "metrics",
      "stream_name": "node_filesystem_avail_bytes",
      "description": "Notify when an allow-listed filesystem reports less than 10 GiB of available/free space.",
      "query_condition": {
        "type": "promql",
        "promql": "min by (mountpoint) (node_filesystem_avail_bytes)",
        "promql_condition": {
          "column": "value",
          "operator": "<",
          "value": 10737418240
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": "<",
        "threshold": 10737418240,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Container restart loop",
      "stream_type": "metrics",
      "stream_name": "ifritah_container_restarts_total",
      "description": "Notify when the bounded container-role restart counter increases by three or more within ten minutes.",
      "query_condition": {
        "type": "promql",
        "promql": "sum by (container_role) (increase(ifritah_container_restarts_total[10m]))",
        "promql_condition": {
          "column": "value",
          "operator": ">=",
          "value": 3
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 3,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Host memory pressure",
      "stream_type": "metrics",
      "stream_name": "node_memory_MemAvailable_bytes",
      "description": "Notify when host available memory falls below the 512 MiB pilot threshold.",
      "query_condition": {
        "type": "promql",
        "promql": "min(node_memory_MemAvailable_bytes)",
        "promql_condition": {
          "column": "value",
          "operator": "<",
          "value": 536870912
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": "<",
        "threshold": 536870912,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Host resource metrics health",
      "stream_type": "metrics",
      "stream_name": "node_cpu_seconds_total",
      "description": "Notify when the node-exporter host resource baseline provides fewer than four CPU samples during the evaluation window.",
      "query_condition": {
        "type": "promql",
        "promql": "count(node_cpu_seconds_total)",
        "promql_condition": {
          "column": "value",
          "operator": "<",
          "value": 4
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": "<",
        "threshold": 4,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Resource exporter health",
      "stream_type": "metrics",
      "stream_name": "ifritah_resource_exporter_up",
      "description": "Notify when the resource exporter provides no healthy heartbeat during the evaluation window.",
      "query_condition": {
        "type": "promql",
        "promql": "max(ifritah_resource_exporter_up)",
        "promql_condition": {
          "column": "value",
          "operator": "<",
          "value": 1
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": "<",
        "threshold": 1,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Resource exporter scrape errors",
      "stream_type": "metrics",
      "stream_name": "ifritah_resource_exporter_scrape_errors_total",
      "description": "Notify when the resource exporter's cumulative scrape-error counter increases during the evaluation window.",
      "query_condition": {
        "type": "promql",
        "promql": "sum(increase(ifritah_resource_exporter_scrape_errors_total[10m]))",
        "promql_condition": {
          "column": "value",
          "operator": ">=",
          "value": 1
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 1,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Telemetry gateway heartbeat missing",
      "stream_type": "metrics",
      "stream_name": "ifritah_gateway_up",
      "description": "Notify when the telemetry gateway provides no healthy heartbeat during the evaluation window.",
      "query_condition": {
        "type": "promql",
        "promql": "max(ifritah_gateway_up)",
        "promql_condition": {
          "column": "value",
          "operator": "<",
          "value": 1
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": "<",
        "threshold": 1,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Telemetry gateway health",
      "stream_type": "metrics",
      "stream_name": "ifritah_gateway_forward_failures_total",
      "description": "Notify when the bounded telemetry gateway's cumulative failure counters increase during the evaluation window.",
      "query_condition": {
        "type": "promql",
        "promql": "sum(increase(ifritah_gateway_forward_failures_total[10m])) + sum(increase(ifritah_gateway_oversized_payloads_total[10m])) + sum(increase(ifritah_gateway_queue_write_errors_total[10m]))",
        "promql_condition": {
          "column": "value",
          "operator": ">=",
          "value": 1
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 1,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    },
    {
      "name": "Ifritah - Telemetry gateway authentication blocked",
      "stream_type": "metrics",
      "stream_name": "ifritah_gateway_auth_blocked",
      "description": "Notify when the telemetry gateway reports an active OpenObserve authentication block.",
      "query_condition": {
        "type": "promql",
        "promql": "max(ifritah_gateway_auth_blocked)",
        "promql_condition": {
          "column": "value",
          "operator": ">=",
          "value": 1
        }
      },
      "trigger_condition": {
        "period": 10,
        "operator": ">=",
        "threshold": 1,
        "frequency": 5,
        "frequency_type": "minutes",
        "silence": 30
      },
      "destinations": [
        "${OPENOBSERVE_ALERT_DESTINATION_NAME}"
      ],
      "enabled": false
    }
  ]
}

{
  "schema_version": 1,
  "streams": [
    {
      "name": "ifritah_logs_v1",
      "type": "logs",
      "retention_days": 14,
      "create": {
        "fields": [],
        "settings": {
          "data_retention": 14,
          "max_query_range": 168,
          "store_original_data": false,
          "index_fields": [
            "event_type",
            "service_name",
            "deployment_environment",
            "request_id",
            "trace_id",
            "operation_id",
            "tenant_id",
            "error_code",
            "error_type",
            "outcome",
            "status_class",
            "route",
            "deployment_stage",
            "script"
          ],
          "full_text_search_keys": [
            "event_type",
            "operation",
            "error_code",
            "error_type"
          ]
        }
      },
      "settings": {
        "data_retention": 14
      },
      "search_fields": [
        "request_id",
        "trace_id",
        "tenant_id",
        "operation_id",
        "service_name",
        "event_type",
        "error_code"
      ]
    },
    {
      "name": "ifritah_traces_v1",
      "type": "traces",
      "retention_days": 7,
      "create": {
        "fields": [],
        "settings": {
          "data_retention": 7,
          "max_query_range": 168,
          "store_original_data": false,
          "index_fields": [
            "trace_id",
            "span_id",
            "parent_span_id",
            "service_name",
            "deployment_environment",
            "operation",
            "route",
            "status_code",
            "duration_ms",
            "error_type"
          ],
          "full_text_search_keys": [
            "service_name",
            "operation",
            "error_type"
          ]
        }
      },
      "settings": {
        "data_retention": 7
      },
      "search_fields": [
        "trace_id",
        "span_id",
        "service_name",
        "operation",
        "route",
        "duration_ms"
      ]
    }
  ],
  "health_signal": {
    "ingress_path": "/v1/health",
    "signal_type": "metrics",
    "query_mode": "promql",
    "retention_days": 15,
    "metric_name_prefixes": [
      "ifritah_gateway_",
      "alloy_",
      "otelcol_",
      "prometheus_"
    ],
    "note": "Health metrics use a dedicated Alloy pipeline and gateway queue, then land in native OpenObserve metric-family streams. No synthetic health log stream is created."
  },
  "metric_stream_policy": {
    "retention_days": 15,
    "max_query_range": 24,
    "allowed_name_prefixes": [
      "ifritah_",
      "node_",
      "alloy_",
      "otelcol_",
      "prometheus_"
    ],
    "note": "OpenObserve native OTLP metrics create one metrics stream per metric family; retention is applied to matching streams after ingestion."
  }
}

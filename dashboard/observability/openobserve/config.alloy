			status_code_input            = "status_code",
			status_class_input           = "status_class",
			legacy_error_type_input      = "error.type",
			duration_ms_input            = "duration_ms",
			dependency_input             = "dependency",
			attempt_input                = "attempt",
			retryable_input              = "retryable",
			build_commit_input           = "build_commit",
			image_digest_input           = "image_digest",
			image_channel_input          = "image_channel",
			scripts_revision_input       = "scripts_revision",
			deployment_stage_input       = "deployment_stage",
			script_input                 = "script",
			resource_type_input          = "resource_type",
			resource_id_input            = "resource_id",
			resource_id_hashed_input     = "resource_id_hashed",
		}
	}

	stage.logfmt {
		source  = "output"
		mapping = {
			timestamp              = "",
			severity_input         = "severity",
			script_input           = "script",
			operation_id_input     = "operation_id",
			tenant_input           = "tenant",
			deployment_stage_input = "deployment_stage",
		}
	}

	stage.template {
		source   = "event_time_candidate"
		template = `{{ .event_time_input | default .timestamp_input | default .timestamp }}`
	}

	stage.regex {
		source     = "event_time_candidate"
		expression = `^(?P<event_time_valid>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{1,9})?Z)$`

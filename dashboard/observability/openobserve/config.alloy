		expression = `^(?P<tenant_valid>[a-z0-9][a-z0-9-]{0,62})$`
	}

	stage.regex {
		source     = "request_id_input"
		expression = `^(?P<request_valid>[A-Za-z0-9._-]{1,64})$`
	}

	stage.regex {
		source     = "trace_id_input"
		expression = `^(?P<trace_valid>[0-9a-f]{32})$`
	}

	stage.regex {
		source     = "span_id_input"
		expression = `^(?P<span_valid>[0-9a-f]{16})$`
	}

	stage.regex {
		source     = "parent_span_id_input"
		expression = `^(?P<parent_span_valid>[0-9a-f]{16})$`
	}

	stage.regex {
		source     = "origin_request_id_input"
		expression = `^(?P<origin_request_valid>[A-Za-z0-9._-]{1,64})$`
	}

	stage.regex {
		source     = "origin_trace_id_input"
		expression = `^(?P<origin_trace_valid>[0-9a-f]{32})$`
	}

	stage.regex {
		source     = "operation_id_input"
		expression = `^(?P<operation_id_valid>[A-Za-z0-9._:-]{1,96})$`
	}

	stage.regex {
		source     = "job_id_input"
		expression = `^(?P<job_valid>[A-Za-z0-9._:-]{1,128})$`
	}

	stage.regex {
		source     = "company_id_input"
		expression = `^(?P<company_valid>[A-Za-z0-9._:-]{1,128})$`
	}

	stage.regex {
		source     = "actor_id_input"
		expression = `^(?P<actor_valid>[A-Za-z0-9._:-]{1,128})$`
	}

	stage.regex {
		source     = "user_id_input"
		expression = `^(?P<actor_fallback_valid>[A-Za-z0-9._:-]{1,128})$`
	}

	stage.regex {
		source     = "route_input"
		expression = `^(?P<route_valid>/[A-Za-z0-9_{}:./-]{0,127})$`
	}

	stage.regex {
		source     = "method_input"
		expression = `^(?P<method_valid>GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|CONNECT|TRACE)$`
	}

	stage.template {
		source   = "status_code_candidate"
		template = `{{ .status_code_input | default .status_input }}`
	}

	stage.regex {
		source     = "status_code_candidate"
		expression = `^(?P<status_valid>[1-5][0-9]{2})$`
	}

	stage.regex {
		source     = "status_code_candidate"
		expression = `^(?P<status_class_from_code>[1-5])[0-9]{2}$`
	}

	stage.template {
		source   = "status_class_candidate"
		template = `{{ if .status_class_input }}{{ .status_class_input }}{{ else if .status_class_from_code }}{{ .status_class_from_code }}xx{{ else }}other{{ end }}`
	}

	stage.regex {
		source     = "status_class_candidate"
		expression = `^(?P<status_class_valid>[1-5]xx|other)$`
	}

	stage.template {
		source   = "outcome_candidate"
		template = `{{ if .outcome_input }}{{ .outcome_input }}{{ else if eq .status_class_candidate "4xx" }}rejected{{ else if eq .status_class_candidate "5xx" }}failure{{ else }}success{{ end }}`
	}

	stage.template {
		source   = "outcome"
		template = `{{ $v := ToLower (.outcome_candidate | default "success") }}{{ if or (eq $v "success") (eq $v "rejected") (eq $v "conflict") (eq $v "timeout") (eq $v "failure") (eq $v "degraded") (eq $v "dropped") }}{{ $v }}{{ else }}degraded{{ end }}`
	}

	stage.regex {
		source     = "duration_ms_input"
		expression = `^(?P<duration_valid>[0-9]{1,9})$`
	}

	stage.regex {
		source     = "dependency_input"
		expression = `^(?P<dependency_valid>[a-z0-9][a-z0-9.-]{0,63})$`
	}

	stage.regex {
		source     = "attempt_input"
		expression = `^(?P<attempt_valid>[1-9]|10)$`
	}

	stage.regex {
		source     = "retryable_input"
		expression = `^(?P<retryable_valid>true|false)$`
	}

	stage.regex {
		source     = "build_commit_input"
		expression = `^(?P<build_commit_valid>[0-9a-f]{1,64})$`
	}

	stage.regex {
		source     = "image_digest_input"
		expression = `^(?P<image_digest_valid>sha256:[0-9a-f]{64})$`
	}

	stage.regex {
		source     = "image_channel_input"
		expression = `^(?P<image_channel_valid>[a-z0-9][a-z0-9_.-]{0,31})$`
	}

	stage.regex {
		source     = "scripts_revision_input"
		expression = `^(?P<scripts_revision_valid>[0-9a-f]{1,64})$`
	}

	stage.regex {
		source     = "deployment_stage_input"
		expression = `^(?P<deployment_stage_valid>[a-z0-9][a-z0-9_.:-]{0,63})$`
	}

	stage.regex {
		source     = "script_input"
		expression = `^(?P<script_valid>[A-Za-z0-9_.-]{1,96})$`
	}

	stage.regex {
		source     = "resource_type_input"
		expression = `^(?P<resource_type_valid>[a-z0-9][a-z0-9_.:-]{0,63})$`
	}

	stage.regex {
		source     = "resource_id_input"
		expression = `^(?P<resource_id_valid>[A-Za-z0-9._:-]{1,128})$`
	}

	stage.regex {
		source     = "resource_id_hashed_input"
		expression = `^(?P<resource_id_hashed_valid>true|false)$`
	}

	stage.template {
		source   = "resource_id_hashed_valid"
		template = `{{ if eq .resource_id_hashed_valid "true" }}true{{ end }}`
	}

	stage.template {
		source   = "redaction_applied"
		template = `{{ if .redaction_candidate }}true{{ else }}false{{ end }}`
	}

	stage.template {
		source   = "canonical_json"
		template = `{"schema_version":1,"event_time":{{ .event_time | toJson }},"signal":"log","event_type":{{ if .event_type_valid }}{{ .event_type_valid | toJson }}{{ else }}"runtime.lifecycle"{{ end }},"severity":{{ .severity | toJson }},"service_name":{{ .service_name | toJson }},"service_version":{{ .service_version | toJson }},"deployment_environment":{{ .deployment_environment | toJson }},"component":{{ if .component_valid }}{{ .component_valid | toJson }}{{ else }}"deployment"{{ end }},"operation":{{ if .operation_valid }}{{ .operation_valid | toJson }}{{ else }}"deployment.operation"{{ end }},"outcome":{{ .outcome | toJson }},"error_code":{{ if .error_code_valid }}{{ .error_code_valid | toJson }}{{ else }}null{{ end }},"error_type":{{ if .error_type_valid }}{{ .error_type_valid | toJson }}{{ else }}null{{ end }},"request_id":{{ if .request_valid }}{{ .request_valid | toJson }}{{ else }}null{{ end }},"trace_id":{{ if .trace_valid }}{{ .trace_valid | toJson }}{{ else }}null{{ end }},"span_id":{{ if .span_valid }}{{ .span_valid | toJson }}{{ else }}null{{ end }},"parent_span_id":{{ if .parent_span_valid }}{{ .parent_span_valid | toJson }}{{ else }}null{{ end }},"origin_request_id":{{ if .origin_request_valid }}{{ .origin_request_valid | toJson }}{{ else }}null{{ end }},"origin_trace_id":{{ if .origin_trace_valid }}{{ .origin_trace_valid | toJson }}{{ else }}null{{ end }},"operation_id":{{ if .operation_id_valid }}{{ .operation_id_valid | toJson }}{{ else }}null{{ end }},"job_id":{{ if .job_valid }}{{ .job_valid | toJson }}{{ else }}null{{ end }},"tenant_scope":{{ if .tenant_valid }}"tenant"{{ else if .script_input }}"control_plane"{{ else }}"unknown"{{ end }},"tenant_id":{{ if .tenant_valid }}{{ .tenant_valid | toJson }}{{ else }}null{{ end }},"company_id":{{ if .company_valid }}{{ .company_valid | toJson }}{{ else }}null{{ end }},"actor_id":{{ if .actor_valid }}{{ .actor_valid | toJson }}{{ else if .actor_fallback_valid }}{{ .actor_fallback_valid | toJson }}{{ else }}null{{ end }},"route":{{ if .route_valid }}{{ .route_valid | toJson }}{{ else }}null{{ end }},"method":{{ if .method_valid }}{{ .method_valid | toJson }}{{ else }}null{{ end }},"status_code":{{ if .status_valid }}{{ .status_valid }}{{ else }}null{{ end }},"status_class":{{ if .status_class_valid }}{{ .status_class_valid | toJson }}{{ else }}null{{ end }},"duration_ms":{{ if .duration_valid }}{{ .duration_valid }}{{ else }}null{{ end }},"dependency":{{ if .dependency_valid }}{{ .dependency_valid | toJson }}{{ else }}null{{ end }},"attempt":{{ if .attempt_valid }}{{ .attempt_valid }}{{ else }}null{{ end }},"retryable":{{ if .retryable_valid }}{{ .retryable_valid }}{{ else }}null{{ end }},"build_version":{{ .service_version | toJson }},"build_commit":{{ if .build_commit_valid }}{{ .build_commit_valid | toJson }}{{ else }}null{{ end }},"image_digest":{{ if .image_digest_valid }}{{ .image_digest_valid | toJson }}{{ else }}null{{ end }},"image_channel":{{ if .image_channel_valid }}{{ .image_channel_valid | toJson }}{{ else }}null{{ end }},"scripts_revision":{{ if .scripts_revision_valid }}{{ .scripts_revision_valid | toJson }}{{ else }}null{{ end }},"deployment_stage":{{ if .deployment_stage_valid }}{{ .deployment_stage_valid | toJson }}{{ else }}null{{ end }},"script":{{ if .script_valid }}{{ .script_valid | toJson }}{{ else }}null{{ end }},"resource_type":{{ if .resource_type_valid }}{{ .resource_type_valid | toJson }}{{ else }}null{{ end }},"resource_id":{{ if and .resource_id_valid .resource_id_hashed_valid }}{{ .resource_id_valid | toJson }}{{ else }}null{{ end }},"resource_id_hashed":{{ if .resource_id_hashed_valid }}{{ .resource_id_hashed_valid }}{{ else }}false{{ end }},"redaction_applied":false,"redaction_rules":[]}`
	}

	stage.template {
		source   = "canonical_json"
		template = `{{ if .redaction_applied }}{{ .canonical_json | replace "\"redaction_applied\":false" "\"redaction_applied\":true" | replace "\"redaction_rules\":[]" "\"redaction_rules\":[\"luhn_card\"]" }}{{ else }}{{ .canonical_json }}{{ end }}`
	}

	stage.output {
		source = "canonical_json"
	}

	stage.limit {
		rate  = 1000
		burst = 2000
		drop  = true
	}
}

otelcol.auth.basic "openobserve" {
	username = sys.env("ZO_ROOT_USER_EMAIL")
	password = sys.env("ZO_ROOT_USER_PASSWORD")
}

// Docker logs are converted from Loki entries to OTLP logs. The OTLP
// receiver remains private on the OpenObserve network for future application
// traces and metrics.
otelcol.receiver.loki "docker" {
	output {
		logs = [otelcol.processor.memory_limiter.main.input]
	}
}

// Tenant OTLP callers must authenticate with the deployment-provided token.
// The token is deliberately not stored in this tracked configuration.
otelcol.auth.basic "tenant" {
	username = "ifritah-tenant"
	password = sys.env("OPENOBSERVE_TENANT_OTLP_TOKEN")
}

otelcol.receiver.otlp "private" {
	grpc {
		endpoint               = "0.0.0.0:4317"
		max_recv_msg_size      = "4MiB"
		max_concurrent_streams = 128
		auth                   = otelcol.auth.basic.tenant.handler
	}

	http {
		endpoint              = "0.0.0.0:4318"
		max_request_body_size = "4MiB"
		auth                  = otelcol.auth.basic.tenant.handler
	}

	output {
		metrics = [otelcol.processor.memory_limiter.main.input]
		logs    = [otelcol.processor.memory_limiter.main.input]
		traces  = [otelcol.processor.memory_limiter.main.input]
	}
}

otelcol.processor.memory_limiter "main" {
	check_interval = "1s"
	limit          = "192MiB"
	spike_limit    = "32MiB"

	output {
		metrics = [otelcol.processor.filter.unsafe.input]
		logs    = [otelcol.processor.filter.unsafe.input]
		traces  = [otelcol.processor.filter.unsafe.input]
	}
}

otelcol.processor.filter "unsafe" {
	error_mode = "ignore"

	logs {
		log_record = [
			`IsString(body) and IsMatch(body, "(?i)(\"?(authorization|cookie|credential|password|secret|session|token|otp|payload|body|query|sql|statement|message|raw)\"?[[:space:]]*[:=])")`,
			`IsString(body) and Len(body) > 65536`,
		]
	}

	output {
		metrics = [otelcol.processor.transform.sanitize.input]
		logs    = [otelcol.processor.transform.sanitize.input]
		traces  = [otelcol.processor.transform.sanitize.input]
	}
}

otelcol.processor.transform "sanitize" {
	error_mode = "ignore"

	trace_statements {
		context    = "resource"
		statements = [
			`delete_matching_keys(attributes, "(?i).*(authorization|cookie|credential|password|secret|session|token|otp|payload|body|query|sql|statement|message|raw).*")`,
			`set(attributes["service.name"], "ifritah-tenant") where not IsMatch(attributes["service.name"], "^ifritah-(backend|frontend)$")`,
			`keep_keys(attributes, ["service.name", "service.version", "deployment.environment.name", "component", "cluster", "host.role", "container.role", "image.channel"])`,
			`truncate_all(attributes, 128)`,
		]
	}

	trace_statements {
		context    = "span"
		statements = [
			`set(attributes["request_id"], attributes["request.id"]) where attributes["request.id"] != nil`,
			`set(attributes["method"], attributes["http.request.method"]) where attributes["http.request.method"] != nil`,
			`set(attributes["route"], attributes["http.route"]) where attributes["http.route"] != nil`,
			`set(attributes["status_code"], attributes["http.response.status_code"]) where attributes["http.response.status_code"] != nil`,
			`set(attributes["error_type"], attributes["error.type"]) where attributes["error.type"] != nil`,
			`set(attributes["error_type"], attributes["exception.type"]) where attributes["error_type"] == nil and attributes["exception.type"] != nil`,
			`set(attributes["operation"], attributes["ifritah.operation"]) where attributes["ifritah.operation"] != nil`,
			`set(attributes["operation"], attributes["db.operation.name"]) where attributes["operation"] == nil and attributes["db.operation.name"] != nil`,
			`set(attributes["operation"], attributes["messaging.operation.type"]) where attributes["operation"] == nil and attributes["messaging.operation.type"] != nil`,
			`set(attributes["duration_ms"], (end_time_unix_nano - start_time_unix_nano) / 1000000)`,
			`delete_key(attributes, "service_name")`,
			`set(attributes["service_name"], resource.attributes["service.name"]) where resource.attributes["service.name"] != nil`,
			`delete_matching_keys(attributes, "(?i).*(authorization|cookie|credential|password|secret|session|token|otp|payload|body|query|sql|statement|message|raw|stacktrace).*")`,
			`keep_keys(attributes, ["service_name", "request_id", "company_id", "actor_id", "operation_id", "job_id", "method", "route", "status_code", "duration_ms", "operation", "error_type", "db.system", "messaging.system", "resource_type", "resource_id"])`,
			`truncate_all(attributes, 256)`,
		]
	}

	metric_statements {
		context    = "resource"
		statements = [
			`delete_matching_keys(attributes, "(?i).*(authorization|cookie|credential|password|secret|session|token|otp|payload|body|query|sql|statement|message|raw).*")`,
			`set(attributes["service.name"], "ifritah-tenant") where attributes["service.name"] == nil`,
			`keep_keys(attributes, ["service.name", "service.version", "deployment.environment.name", "component", "cluster", "host.role", "container.role", "image.channel"])`,
			`truncate_all(attributes, 64)`,
		]
	}

	metric_statements {
		context    = "datapoint"
		statements = [
			`delete_matching_keys(attributes, "(?i).*(tenant|request|trace|span|actor|user|resource|digest|authorization|cookie|credential|password|secret|session|token|otp|payload|body|query|sql|statement|message|raw).*")`,
			`set(attributes["service_name"], resource.attributes["service.name"]) where attributes["service_name"] == nil and resource.attributes["service.name"] != nil`,
			`keep_keys(attributes, ["service_name", "deployment_environment", "dependency", "operation", "outcome", "method", "route", "status_class", "container_role", "host_role", "device", "interface", "mountpoint", "mode", "cpu"])`,
			`truncate_all(attributes, 64)`,
		]
	}

	log_statements {
		context    = "resource"
		statements = [
			`delete_matching_keys(attributes, "(?i).*(authorization|cookie|credential|password|secret|session|token|otp|payload|body|query|sql|statement|message|raw).*")`,
			`set(attributes["service.name"], "ifritah-tenant")`,
			`keep_keys(attributes, ["service.name", "service.version", "deployment.environment.name", "component", "cluster", "host.role", "container.role", "service_name"])`,
			`truncate_all(attributes, 128)`,
		]
	}

	log_statements {
		context    = "log"
		statements = [
			`replace_pattern(body, "(?s)^(.{0,1000}).*$", "$1[TRUNCATED]") where IsString(body) and Len(body) > 1000`,
			`merge_maps(attributes, ParseJSON(body), "upsert") where IsString(body) and IsMatch(body, "^\\s*\\{")`,
			`delete_matching_keys(attributes, "(?i).*(authorization|cookie|credential|password|secret|session|token|otp|payload|body|query|sql|statement|message|raw).*")`,
			`delete_key(attributes, "tenant_id")`,
			`delete_key(attributes, "tenant_scope")`,
			`delete_key(attributes, "tenant")`,
			`set(attributes["service_name"], resource.attributes["service.name"]) where resource.attributes["service.name"] != nil`,
			`keep_keys(attributes, ["schema_version", "event_time", "signal", "event_type", "severity", "service_name", "service_version", "deployment_environment", "component", "operation", "outcome", "error_code", "error_type", "request_id", "trace_id", "span_id", "parent_span_id", "origin_request_id", "origin_trace_id", "operation_id", "job_id", "tenant_scope", "tenant_id", "company_id", "actor_id", "route", "method", "status_code", "status_class", "duration_ms", "dependency", "attempt", "retryable", "build_version", "build_commit", "image_digest", "image_channel", "scripts_revision", "deployment_stage", "script", "resource_type", "resource_id", "resource_id_hashed", "redaction_applied", "redaction_rules", "container_role"])`,
			`truncate_all(attributes, 256)`,
		]
	}

	output {
		metrics = [otelcol.processor.batch.main.input]
		logs    = [otelcol.processor.batch.main.input]
		traces  = [otelcol.processor.batch.main.input]
	}
}

otelcol.processor.batch "main" {
	timeout             = "10s"
	send_batch_size     = 128
	send_batch_max_size = 128

	output {
		logs    = [otelcol.exporter.otlphttp.logs.input]
		metrics = [otelcol.exporter.otlphttp.metrics.input]
		traces  = [otelcol.exporter.otlphttp.traces.input]
	}
}

// Resource signals are scraped privately and converted into OTLP metrics.
prometheus.scrape "host_resources" {
	job_name        = "openobserve-host-resources"
	scrape_interval = "15s"
	scrape_timeout  = "5s"
	body_size_limit = "2MiB"
	sample_limit    = 2048
	label_limit     = 32
	targets         = [{
		"__address__"  = "node-exporter-openobserve:9100",
		"service_name" = "ifritah-node-exporter",
		"host_role"    = "deployment",
	}]
	forward_to = [otelcol.receiver.prometheus.direct.receiver]
}

prometheus.scrape "container_resources" {
	job_name        = "openobserve-container-resources"
	scrape_interval = "15s"
	scrape_timeout  = "5s"
	body_size_limit = "2MiB"
	sample_limit    = 1024
	label_limit     = 16
	targets         = [{
		"__address__"  = "resource-exporter-openobserve:8080",
		"service_name" = "ifritah-resource-exporter",
		"host_role"    = "deployment",
	}]
	forward_to = [otelcol.receiver.prometheus.direct.receiver]
}

otelcol.receiver.prometheus "direct" {
	output {
		metrics = [otelcol.processor.memory_limiter.main.input]
	}
}

otelcol.receiver.prometheus "application" {
	output {
		metrics = [otelcol.processor.memory_limiter.main.input]
	}
}

// Scrape only bounded component/gateway health metrics. These signals are
// exported separately so queue pressure and auth/schema failures remain
// visible even when normal telemetry is being dropped.
prometheus.scrape "collector_health" {
	job_name        = "openobserve-collector-health"
	scrape_interval = "15s"
	scrape_timeout  = "5s"
	body_size_limit = "2MiB"
	sample_limit    = 2048
	label_limit     = 16
	targets         = [
		{
			"__address__"  = "127.0.0.1:12345",
			"service_name" = "ifritah-alloy",
			"component"    = "collector",
		},
		{
			"__address__"  = "openobserve-gateway:8080",
			"service_name" = "ifritah-openobserve-gateway",
			"component"    = "gateway",
		},
	]
	forward_to = [otelcol.receiver.prometheus.health_direct.receiver]
}

otelcol.receiver.prometheus "health_direct" {
	output {
		metrics = [otelcol.processor.memory_limiter.main.input]
	}
}

// Alloy has a bounded in-memory queue; the gateway adds a durable per-signal
// disk queue capped at 64 MiB and is the only component that talks to
// OpenObserve.
otelcol.exporter.otlphttp "logs" {
	logs_endpoint = "http://openobserve-gateway:4318/v1/logs"

	client {
		endpoint                = "http://openobserve-gateway:4318"
		timeout                 = "5s"
		compression             = "none"
		max_conns_per_host      = 4
		max_idle_conns_per_host = 4
	}

	sending_queue {
		enabled       = true
		num_consumers = 2
		queue_size    = 40
	}

	retry_on_failure {
		enabled              = true
		initial_interval     = "5s"
		max_interval         = "30s"
		max_elapsed_time     = "30s"
		multiplier           = 1.5
		randomization_factor = 0.2
	}
}

otelcol.exporter.otlphttp "metrics" {
	metrics_endpoint = "http://openobserve-gateway:4318/v1/metrics"

	client {
		endpoint                = "http://openobserve-gateway:4318"
		timeout                 = "5s"
		compression             = "none"
		max_conns_per_host      = 4
		max_idle_conns_per_host = 4
	}

	sending_queue {
		enabled       = true
		num_consumers = 2
		queue_size    = 40
	}

	retry_on_failure {
		enabled              = true
		initial_interval     = "5s"
		max_interval         = "30s"
		max_elapsed_time     = "30s"
		multiplier           = 1.5
		randomization_factor = 0.2
	}
}

otelcol.exporter.otlphttp "traces" {
	traces_endpoint = "http://openobserve-gateway:4318/v1/traces"

	client {
		endpoint                = "http://openobserve-gateway:4318"
		timeout                 = "5s"
		compression             = "none"
		max_conns_per_host      = 4
		max_idle_conns_per_host = 4
	}

	sending_queue {
		enabled       = true
		num_consumers = 2
		queue_size    = 40
	}

	retry_on_failure {
		enabled              = true
		initial_interval     = "5s"
		max_interval         = "30s"
		max_elapsed_time     = "30s"
		multiplier           = 1.5
		randomization_factor = 0.2
	}
}

otelcol.exporter.otlphttp "health" {
	metrics_endpoint = "http://openobserve-gateway:4318/v1/health"

	client {
		endpoint                = "http://openobserve-gateway:4318"
		timeout                 = "5s"
		compression             = "none"
		max_conns_per_host      = 2
		max_idle_conns_per_host = 2
	}

	sending_queue {
		enabled       = true
		num_consumers = 1
		queue_size    = 20
	}

	retry_on_failure {
		enabled              = true
		initial_interval     = "5s"
		max_interval         = "30s"
		max_elapsed_time     = "30s"
		multiplier           = 1.5
		randomization_factor = 0.2
	}
}

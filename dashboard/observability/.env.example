# Copy to observability/.env and keep it out of version control.
OBS_GRAFANA_ADMIN_USER=admin
OBS_GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
OBS_GRAFANA_PORT=3000
OBS_PROMETHEUS_RETENTION_TIME=7d
OBS_PROMETHEUS_RETENTION_SIZE=5GB

# Optional alert delivery. Leave blank unless the operator has approved an
# outbound path for Grafana; the observability network remains internal-only.
# The contact-point templates under grafana/alerting-templates are not loaded
# until copied into Grafana provisioning and unused receivers are removed.
OBS_ALERT_SLACK_WEBHOOK_URL=
OBS_ALERT_EMAIL_TO=
OBS_SMTP_ENABLED=false
# Grafana expects host and port together, for example smtp.example.com:587.
OBS_SMTP_HOST=
OBS_SMTP_USER=
OBS_SMTP_PASSWORD=
OBS_SMTP_FROM_ADDRESS=
OBS_SMTP_FROM_NAME=Ifritah Grafana
OBS_SMTP_STARTTLS_POLICY=MandatoryStartTLS
OBS_SMTP_SKIP_VERIFY=false

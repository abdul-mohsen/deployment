          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x_axis_1, COUNT(*) AS y_axis_1 FROM \"ifritah_logs_v1\" WHERE _timestamp >= now() - INTERVAL '1 hour' AND event_type = 'http.request.completed' GROUP BY x_axis_1 ORDER BY x_axis_1 LIMIT 120",
              "customQuery": true,
              "fields": {
                "stream": "ifritah_logs_v1",

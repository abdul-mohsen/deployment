# Backend local-dev environment
# Copy to .env and edit. Never commit .env.

# Database
DB_NAME=app_dev
DB_USER=root
DB_PASSWORD=devpass
DB_PORT_HOST=3307

# API
API_PORT=3000
NODE_ENV=development

# App-specific secrets (uncomment as needed)
# JWT_SECRET=
# ENCRYPTION_KEY=

# ZATCA / NATS
# In a deployment with the first-class daemon, point this at the daemon-owned
# host endpoint. Local development may use the standalone setup-nats.sh path.
NATS_URL=nats://host.docker.internal:4222

# Tag used by `docker compose build` for local image
IMAGE_NAME=local/api
